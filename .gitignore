# Never track secrets or machine-local state.
.mcp.json
settings.local.json
*.local.json
.env
.env.*
!.env.example

# Python bytecode from the skill scripts.
__pycache__/
*.pyc

# Backups created by install.sh
.config-backup-*/

.DS_Store

# Superpowers working artifacts (brainstorm questions, specs, plans) and
# SDD orchestration scratch — session-local, never repo content.
docs/superpowers/
.superpowers/

# Skill eval runs: raw harness logs and results.
evals/results/

# Written by Claude Code each time it loads a mod from a folder: this build's
# API types and a tsconfig.json that points at them.
plugins/*/.claude-plugin/types/
plugins/*/tsconfig.json

# Agent worktrees, checked out inside the repo.
.claude/worktrees/
