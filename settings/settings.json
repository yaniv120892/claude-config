{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill",
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "auto"
  },
  "model": "Opus",
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "promptSuggestionEnabled": true,
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0
  },
  "extraKnownMarketplaces": {
    "yaniv-claude-config": {
      "source": {
        "source": "github",
        "repo": "yaniv120892/claude-config"
      }
    }
  },
  "enabledPlugins": {
    "pr-workflows@yaniv-claude-config": true,
    "dev-workflows@yaniv-claude-config": true,
    "cmux@yaniv-claude-config": true
  }
}
