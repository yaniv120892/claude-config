{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill",
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "auto"
  },
  "model": "Opus",
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "promptSuggestionEnabled": true,
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/pre-push-quality-gate.sh\"",
            "if": "Bash(git push:*)",
            "timeout": 300,
            "statusMessage": "Running pre-push checks (build, lint, prettier, test)..."
          }
        ]
      }
    ]
  }
}
