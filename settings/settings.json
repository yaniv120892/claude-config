{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Skill",
      "WebSearch",
      "WebFetch",
      "mcp__Linear",
      "mcp__BetterStack",
      "mcp__Vercel"
    ],
    "ask": [
      "mcp__Linear__delete_comment",
      "mcp__Linear__delete_diff_comment",
      "mcp__Linear__delete_status_update",
      "mcp__Linear__delete_attachment",
      "mcp__BetterStack__status_page_report_update",
      "mcp__Vercel__buy_addon",
      "mcp__Vercel__buy_credits",
      "mcp__Vercel__buy_domain",
      "mcp__Vercel__buy_pro",
      "mcp__Vercel__deploy_to_vercel",
      "mcp__Vercel__create_git_project",
      "mcp__Vercel__pause_project",
      "mcp__Vercel__unpause_project",
      "mcp__Vercel__update_project_deployment_protection"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/require-git-approval.sh"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark",
  "promptSuggestionEnabled": true,
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "worktree": {
    "baseRef": "fresh",
    "bgIsolation": "worktree"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0
  },
  "extraKnownMarketplaces": {
    "yaniv-claude-config": {
      "source": {
        "source": "github",
        "repo": "yaniv120892/claude-config"
      }
    }
  },
  "enabledPlugins": {
    "pr-workflows@yaniv-claude-config": true,
    "dev-workflows@yaniv-claude-config": true,
    "cmux@yaniv-claude-config": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$PPID; while [ \"${p:-1}\" -gt 1 ] && ! ps -o comm= -p \"$p\" | grep -q 'claude$'; do p=$(ps -o ppid= -p \"$p\" | tr -d ' '); done; [ \"${p:-1}\" -gt 1 ] && { pgrep -qf \"caffeinate -is -w $p\\$\" || nohup caffeinate -is -w \"$p\" >/dev/null 2>&1 & }; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
