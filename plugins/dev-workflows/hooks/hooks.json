{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/require-worktree.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the edit lands in a worktree, not the main checkout..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/post-merge-cleanup.sh\"",
            "timeout": 120,
            "statusMessage": "Cleaning up after the merge..."
          }
        ]
      }
    ]
  }
}
